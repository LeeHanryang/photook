<UserControl x:Class="PhotoOk.Views.SourceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PhotoOk.Views">
    <UserControl.Resources>
        <views:EnumEqualsConverter x:Key="EnumEquals" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
        <!-- 안내 문구: 내용이 없으면(null) 자리도 차지하지 않는다. -->
        <Style x:Key="NoticeText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#8A5A00" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
              <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Grid.Row" Value="0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ArchiveFirst}" Value="True">
                                <Setter Property="Grid.Row" Value="1" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding SourcesTitle}" Style="{StaticResource SectionTitle}" />
                <ListBox ItemsSource="{Binding Sources}" MinHeight="64" MaxHeight="160"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="빼기" Padding="10,2" Margin="12,0,0,0"
                                        Command="{Binding DataContext.RemoveSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="폴더 추가…" Command="{Binding AddSourceCommand}"
                        HorizontalAlignment="Left" Padding="14,5" Margin="0,8,0,0" />
                <CheckBox Content="하위 폴더까지 포함" IsChecked="{Binding IncludeSubfolders}" Margin="0,10,0,0"
                          Visibility="{Binding ShowIncludeSubfolders, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding WholeArchiveNotice}" Style="{StaticResource NoticeText}" />
                </StackPanel>

                <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Grid.Row" Value="1" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ArchiveFirst}" Value="True">
                                <Setter Property="Grid.Row" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="보관 폴더" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding ArchiveRoot, Mode=OneWay}" IsReadOnly="True" Padding="6,4" />
                    <Button Grid.Column="1" Content="폴더 선택…" Command="{Binding PickArchiveCommand}"
                            Padding="14,5" Margin="8,0,0,0" />
                </Grid>
                </StackPanel>
              </Grid>

                <TextBlock Text="정리 방식" Style="{StaticResource SectionTitle}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Name" Padding="6,4" />
                    <Button Grid.Column="1" Content="프리셋 파일 열기…" Command="{Binding OpenPresetFileCommand}"
                            Padding="14,5" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding SelectedPreset.Description}" TextWrapping="Wrap" Opacity="0.7" Margin="0,6,0,0" />
                <CheckBox Content="폴더 이름을 이벤트 이름으로 쓰기" IsChecked="{Binding UseFolderNames}" Margin="0,10,0,0"
                          Visibility="{Binding ShowUseFolderNames, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding EventsNotUsedNotice}" Style="{StaticResource NoticeText}" />

                <StackPanel Visibility="{Binding ShowModeChoice, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="가져오는 방식" Style="{StaticResource SectionTitle}" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="복사 (원본을 그대로 둠)" GroupName="Mode" Margin="0,0,24,0"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Copy}" />
                    <RadioButton Content="이동" GroupName="Mode"
                                 IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Move}" />
                </StackPanel>
                <TextBlock Text="{Binding MoveHint}" TextWrapping="Wrap" Foreground="#555555" Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MoveHint}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding MoveNotice}" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,6,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="뒤로" Command="{Binding BackCommand}" Padding="24,8" />
            <TextBlock Grid.Column="1" Text="{Binding ValidationMessage}" Foreground="#B00020" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="16,0" />
            <Button Grid.Column="2" Content="다음" Command="{Binding NextCommand}" Padding="32,8" IsDefault="True" />
        </Grid>
    </Grid>
</UserControl>
