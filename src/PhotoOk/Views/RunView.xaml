<UserControl x:Class="PhotoOk.Views.RunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- 값이 없거나(null) 비어 있으면 숨기는 글줄. -->
        <Style x:Key="OptionalText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 줄이 없으면 숨기는 목록. -->
        <Style x:Key="LineList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="900" HorizontalAlignment="Left">
            <!-- 실행 중 -->
            <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="정리하는 중입니다" FontSize="24" FontWeight="Bold" />
                <ProgressBar Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Done, Mode=OneWay}"
                             Height="8" Margin="0,24,0,0" />
                <TextBlock Text="{Binding ProgressText}" FontSize="16" Margin="0,12,0,0" />
                <TextBlock Text="{Binding CurrentFileName}" Opacity="0.7" TextTrimming="CharacterEllipsis"
                           Margin="0,4,0,0" />
            </StackPanel>

            <!-- 끝난 뒤 -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ResultTitle}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding ResultTitle}" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SucceededFilesText}" Style="{StaticResource OptionalText}"
                           Margin="0,6,0,0" Opacity="0.8" />
                <TextBlock Text="{Binding SafeToCleanMessage}" Style="{StaticResource OptionalText}"
                           FontSize="16" FontWeight="SemiBold" Foreground="#FF1B7F3B" />
                <TextBlock Text="{Binding CautionMessage}" Style="{StaticResource OptionalText}"
                           FontWeight="SemiBold" Foreground="#FFB45309" />
            </StackPanel>
        </StackPanel>

        <ScrollViewer Grid.Row="1" MaxWidth="900" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto"
                      Margin="0,8,0,0">
            <StackPanel>
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FailureLines.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="처리하지 못한 항목" Style="{StaticResource ListHeader}" />
                    <ItemsControl ItemsSource="{Binding FailureLines}" Style="{StaticResource LineList}" />
                </StackPanel>

                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WarningLines.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="알림" Style="{StaticResource ListHeader}" />
                    <ItemsControl ItemsSource="{Binding WarningLines}" Style="{StaticResource LineList}" Opacity="0.8" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,24,0,0">
            <Button Content="취소" Command="{Binding CancelCommand}" Padding="24,8" Margin="0,0,12,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="이어 하기" Command="{Binding ResumeCommand}" Padding="24,8" Margin="0,0,12,0"
                    Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="처음으로" Command="{Binding HomeCommand}" Padding="24,8" Margin="0,0,12,0" />
            <Button Content="작업 기록" Command="{Binding OpenHistoryCommand}" Padding="24,8" />
        </StackPanel>
    </Grid>
</UserControl>
