<UserControl x:Class="PhotoOk.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PhotoOk.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:HistoryStatusTextConverter x:Key="StatusText" />
        <views:InvertBooleanConverter x:Key="InvertBool" />

        <!-- 줄이 없으면 숨기는 목록. -->
        <Style x:Key="LineList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 값이 없으면(null) 숨기는 글줄. -->
        <Style x:Key="OptionalText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="48,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="작업 기록" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="끝나지 않은 작업은 이어 하고, 마친 작업은 되돌릴 수 있습니다. 되돌려도 파일을 지우지 않고 보관 폴더로 옮깁니다."
                       TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0" />
            <TextBlock Text="되돌리는 중입니다" FontWeight="SemiBold" Margin="0,16,0,0"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <ProgressBar IsIndeterminate="True" Height="6" Margin="0,6,0,0"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <StackPanel Grid.Row="1" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="읽지 못한 기록" FontWeight="SemiBold" Margin="0,12,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LoadErrors.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding LoadErrors}" Style="{StaticResource LineList}" Foreground="#FFB45309" />
        </StackPanel>

        <Grid Grid.Row="2" MaxWidth="900" HorizontalAlignment="Stretch" Margin="0,12,0,0">
            <TextBlock Text="아직 작업 기록이 없습니다." Opacity="0.7">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Runs.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="4,6">
                            <TextBlock>
                                <Run Text="{Binding StartedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource StatusText}}" />
                            </TextBlock>
                            <TextBlock Opacity="0.8">
                                <Run Text="완료 " /><Run Text="{Binding CompletedFiles, Mode=OneWay}" /><Run Text=" / 전체 " /><Run Text="{Binding FileOperations, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Text="{Binding ArchiveRoot, Mode=OneWay}" Opacity="0.7"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <ScrollViewer Grid.Row="3" MaxWidth="900" HorizontalAlignment="Left" VerticalScrollBarVisibility="Auto"
                      MaxHeight="200">
            <StackPanel>
                <TextBlock Text="{Binding UndoSummary}" Style="{StaticResource OptionalText}"
                           FontSize="16" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding UndoResultLines}" Style="{StaticResource LineList}" Opacity="0.85" />
                <TextBlock Text="{Binding UndoFault}" Style="{StaticResource OptionalText}"
                           FontWeight="SemiBold" Foreground="#FFB45309" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,24,0,0">
            <Button Content="취소" Command="{Binding CancelCommand}" Padding="24,8" Margin="0,0,12,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
            <Button Content="이어 하기" Command="{Binding ResumeCommand}" Padding="24,8" Margin="0,0,12,0" />
            <Button Content="되돌리기" Command="{Binding UndoCommand}" Padding="24,8" Margin="0,0,12,0" />
            <Button Content="처음으로" Command="{Binding HomeCommand}" Padding="24,8" />
        </StackPanel>
    </Grid>
</UserControl>
