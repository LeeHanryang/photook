<UserControl x:Class="PhotoOk.Views.PreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhotoOk.ViewModels"
             xmlns:views="clr-namespace:PhotoOk.Views">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <views:EnumEqualsConverter x:Key="EnumEquals" />
        <views:InvertBooleanConverter x:Key="InvertBool" />
        <SolidColorBrush x:Key="MismatchBrush" Color="#C2570C" />
        <Style x:Key="OptionLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OptionGroup" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,6,24,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PaneTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="SummaryItem" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,24,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 계획에서 나온 안내. 값이 없거나 계획이 아직 없으면 숨긴다. -->
        <Style x:Key="PlanNotice" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MismatchBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
                <DataTrigger Binding="{Binding HasPlan}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,6,12,0" />
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" />
                <TextBlock Margin="8,0,0,0" Opacity="0.6">
                    <Run Text="{Binding FileCount, Mode=OneWay}" /><Run Text="개" />
                </TextBlock>
                <Border Margin="8,0,0,0" Padding="4,0" CornerRadius="3" Background="#E3F2E6">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNew}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="새 폴더" FontSize="11" Foreground="#1B5E20" />
                </Border>
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 위쪽 요약 -->
        <StackPanel>
            <TextBlock Text="정리 미리보기" FontSize="22" FontWeight="Bold" />
            <!-- 옵션: 바꾸면 다시 스캔하지 않고 촬영 묶기와 계획만 다시 세운다. -->
            <WrapPanel Margin="0,6,0,0">
                <StackPanel Style="{StaticResource OptionGroup}">
                    <TextBlock Text="정리 방식" Style="{StaticResource OptionLabel}" />
                    <ComboBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}"
                              DisplayMemberPath="Name" MinWidth="160" Padding="6,3" />
                </StackPanel>
                <StackPanel Style="{StaticResource OptionGroup}"
                            Visibility="{Binding ShowFolderOptions, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Content="폴더 이름을 이벤트 이름으로 쓰기" IsChecked="{Binding UseFolderNames}"
                              VerticalAlignment="Center" Margin="0,0,16,0" />
                    <!-- Content에 글자를 바로 쓰면 _가 단축키 표시로 사라지므로 TextBlock에 넣는다. -->
                    <CheckBox IsChecked="{Binding SplitUnderscores}" VerticalAlignment="Center">
                        <TextBlock Text="이름의 _ 를 폴더로 나누기" />
                    </CheckBox>
                </StackPanel>
                <StackPanel Style="{StaticResource OptionGroup}"
                            Visibility="{Binding ShowFolderOptions, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="하위 폴더" Style="{StaticResource OptionLabel}" />
                    <RadioButton Content="유지" GroupName="SubfolderOption" Margin="0,0,10,0" VerticalAlignment="Center"
                                 IsChecked="{Binding Subfolders, Converter={StaticResource EnumEquals}, ConverterParameter=Keep}" />
                    <RadioButton Content="제자리에 둠" GroupName="SubfolderOption" Margin="0,0,10,0" VerticalAlignment="Center"
                                 IsChecked="{Binding Subfolders, Converter={StaticResource EnumEquals}, ConverterParameter=InPlace}" />
                    <RadioButton Content="합치기" GroupName="SubfolderOption" VerticalAlignment="Center"
                                 IsChecked="{Binding Subfolders, Converter={StaticResource EnumEquals}, ConverterParameter=Merge}" />
                </StackPanel>
                <StackPanel Style="{StaticResource OptionGroup}"
                            Visibility="{Binding ShowReviewOption, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="판단 필요 파일" Style="{StaticResource OptionLabel}" />
                    <RadioButton Content="제자리에 둠" GroupName="ReviewOption" Margin="0,0,10,0" VerticalAlignment="Center"
                                 IsChecked="{Binding KeepReviewInPlace}" />
                    <RadioButton Content="판단 필요 폴더로" GroupName="ReviewOption" VerticalAlignment="Center"
                                 IsChecked="{Binding KeepReviewInPlace, Converter={StaticResource InvertBool}}" />
                </StackPanel>
                <StackPanel Style="{StaticResource OptionGroup}"
                            Visibility="{Binding ShowReviewOption, Converter={StaticResource BoolToVisibility}}">
                    <CheckBox Content="여러 날 폴더도 날짜별로 나누기" IsChecked="{Binding SplitMultiDayFolders}" VerticalAlignment="Center" />
                </StackPanel>
            </WrapPanel>
            <WrapPanel Margin="0,10,0,0">
                <Button Content="모두 옮기기" Command="{Binding IncludeAllCommand}" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center" />
                <Button Content="모두 빼기" Command="{Binding ExcludeAllCommand}" Padding="8,2" Margin="0,0,24,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource SummaryItem}" Text="{Binding ExcludedText}" FontWeight="SemiBold" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="{Binding DateDifferText}" FontWeight="SemiBold" Foreground="{StaticResource MismatchBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DateDifferText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- 날짜가 다른 파일이 있을 때만 보인다(값이 null이면 두 버튼을 함께 숨김). -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DateDifferText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Content="모두 폴더 날짜로" Command="{Binding AllToFolderDateCommand}" Padding="8,2" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <Button Content="모두 사진 날짜로" Command="{Binding AllToPhotoDateCommand}" Padding="8,2" Margin="0,0,16,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource SummaryItem}">
                    <Run Text="판단 필요" /> <Run Text="{Binding ReviewCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="개" />
                </TextBlock>
                <TextBlock Style="{StaticResource SummaryItem}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="중복" /> <Run Text="{Binding DuplicateCount, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="개" />
                </TextBlock>
                <TextBlock Text="{Binding KeptInPlaceText}" FontWeight="SemiBold">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding KeptInPlaceText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPlan}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding MultiDayNotice}" FontWeight="SemiBold" Foreground="{StaticResource MismatchBrush}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MultiDayNotice}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasPlan}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource SummaryItem}" Text="{Binding TransferText}" FontWeight="SemiBold" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource SummaryItem}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="용량" /> <Run Text="{Binding TransferSizeText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <TextBlock Style="{StaticResource SummaryItem}" Visibility="{Binding HasPlan, Converter={StaticResource BoolToVisibility}}">
                    <Run Text="대상 여유 공간" /> <Run Text="{Binding FreeSpaceText, Mode=OneWay}" FontWeight="SemiBold" />
                </TextBlock>
                <!-- 계획을 세우는 동안만 보인다(값이 null이면 숨김). -->
                <TextBlock Text="{Binding PlanningText}" Opacity="0.7">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SummaryItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PlanningText}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </WrapPanel>
            <!-- 긴 안내는 숫자 사이에 끼지 않게 요약 아래에 한 줄씩 둔다. -->
            <StackPanel>
                <TextBlock Text="{Binding DayFolderLostNotice}" Style="{StaticResource PlanNotice}" />
                <TextBlock Text="{Binding PhotoDateRevertNotice}" Style="{StaticResource PlanNotice}" />
            </StackPanel>
            <Expander Margin="0,8,0,0">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ScanErrors.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Expander.Header>
                    <TextBlock Foreground="#B00020">
                        <Run Text="스캔 오류" /> <Run Text="{Binding ScanErrors.Count, Mode=OneWay}" /><Run Text="건" />
                    </TextBlock>
                </Expander.Header>
                <ListBox ItemsSource="{Binding ScanErrors}" MaxHeight="120" Margin="0,4,0,0" />
            </Expander>
            <Expander Margin="0,4,0,0">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IgnoredCount}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Expander.Header>
                    <TextBlock Text="{Binding IgnoredNotice}" Foreground="#8A5A00" />
                </Expander.Header>
                <ListBox ItemsSource="{Binding IgnoredFiles}" MaxHeight="120" Margin="0,4,0,0"
                         VirtualizingPanel.IsVirtualizing="True" />
            </Expander>
            <Expander Margin="0,4,0,0">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PlanNotes.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <Expander.Header>
                    <TextBlock>
                        <Run Text="계획 메모" /> <Run Text="{Binding PlanNotes.Count, Mode=OneWay}" /><Run Text="건" />
                    </TextBlock>
                </Expander.Header>
                <ListBox ItemsSource="{Binding PlanNotes}" MaxHeight="120" Margin="0,4,0,0" />
            </Expander>
        </StackPanel>

        <!-- 세 칸: 촬영 카드 / 폴더 트리 / 선택 촬영 -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="240" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="360" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="촬영" Style="{StaticResource PaneTitle}" />
                <ListBox ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
                         HorizontalContentAlignment="Stretch"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                            <Grid Margin="2,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- 마우스와 자동화 Toggle 모두 값 묶음으로 온다. 어느 쪽으로 바꿀지는 카드가 정한다(일부일 때 누르면 모두 포함). -->
                                <CheckBox Grid.ColumnSpan="2" Margin="0,0,0,6" IsChecked="{Binding IsIncluded}"
                                          Visibility="{Binding ShowIncludeCheckBox, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding IncludeLabel}" />
                                </CheckBox>
                                <Border Grid.Row="1" Width="64" Height="64" Background="#EEEEEE" VerticalAlignment="Top">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Devices}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReviewGroup}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <TextBox x:Name="EventNameBox" Padding="4,2"
                                                 Text="{Binding EventName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="이벤트 이름(비워 두면 날짜만)" />
                                        <TextBlock Text="이벤트 이름" Opacity="0.45" Margin="7,3,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=EventNameBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <!-- 폴더 이름에서 읽은 이름 그대로일 때만 보인다. 카드 너비에서 버튼 글자가 잘리지 않게 위아래로 둔다. -->
                                    <StackPanel Margin="0,4,0,0"
                                                Visibility="{Binding NameFromFolder, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="폴더 이름에서 읽음" FontSize="11" Opacity="0.7" />
                                        <Button Content="이 이름 다시 쓰지 않기" Command="{Binding NeverUseNameCommand}"
                                                Visibility="{Binding CanNeverUseName, Converter={StaticResource BoolToVisibility}}"
                                                HorizontalAlignment="Left" Margin="0,4,0,0" Padding="6,1" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Text="자동으로 정할 수 없는 파일입니다" Opacity="0.7" Margin="0,6,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsReviewGroup}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Note}" Opacity="0.7" TextWrapping="Wrap" Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Note}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding ExcludedNote}" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ExcludedNote}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <WrapPanel Margin="0,4,0,0">
                                        <WrapPanel.Style>
                                            <Style TargetType="WrapPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding FolderDateNote}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </WrapPanel.Style>
                                        <TextBlock Text="{Binding FolderDateNote}" Foreground="{StaticResource MismatchBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="사진 날짜로 보내기" Command="{Binding SendToPhotoDateCommand}" Padding="8,2" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4,0,0">
                                        <WrapPanel.Style>
                                            <Style TargetType="WrapPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PhotoDateNote}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </WrapPanel.Style>
                                        <TextBlock Text="{Binding PhotoDateNote}" Foreground="{StaticResource MismatchBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="폴더 날짜로 되돌리기" Command="{Binding BackToFolderDateCommand}" Padding="8,2" VerticalAlignment="Center" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding NoCaptureNote}" Foreground="{StaticResource MismatchBrush}" TextWrapping="Wrap" Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NoCaptureNote}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <DockPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock DockPanel.Dock="Top" Text="정리 후 폴더" Style="{StaticResource PaneTitle}" />
                <TreeView ItemsSource="{Binding FolderTree}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="선택한 촬영" Style="{StaticResource PaneTitle}" />
                <ListBox DockPanel.Dock="Top" ItemsSource="{Binding Thumbnails}" SelectedItem="{Binding SelectedThumbnail}"
                         MaxHeight="210" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThumbnailItemViewModel}">
                            <StackPanel Width="88" Margin="2">
                                <Border Width="80" Height="80" Background="#EEEEEE">
                                    <Image Source="{Binding Image}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                    <ScrollViewer.Style>
                        <Style TargetType="ScrollViewer">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ScrollViewer.Style>
                    <StackPanel DataContext="{Binding Detail}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="파일" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="1" Text="기기" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Device}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="촬영 시각" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldValue}">
                                <Run Text="{Binding CaptureTime, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding CaptureSource, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="왜 이 경로인가" Style="{StaticResource PaneTitle}" Margin="0,16,0,4" />
                        <TextBlock Text="{Binding Destination}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SkipNote}" TextWrapping="Wrap" Foreground="#8A5A00" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding DateMismatch}" TextWrapping="Wrap" Foreground="{StaticResource MismatchBrush}" Margin="0,4,0,0" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="분기" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding BranchName}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="1" Text="템플릿" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Template}" Style="{StaticResource FieldValue}" />
                            <TextBlock Grid.Row="2" Text="사유" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReasonsText}" Style="{StaticResource FieldValue}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- 아래: 뒤로 / 막힌 이유 / 실행 -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Content="뒤로" Command="{Binding BackCommand}" Padding="24,8" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding BlockingReason}" Foreground="#B00020" TextWrapping="Wrap" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding ScanErrorNotice}" Foreground="#B00020" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="3" Content="실행" Command="{Binding ExecuteCommand}" Padding="32,8"
                    VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
