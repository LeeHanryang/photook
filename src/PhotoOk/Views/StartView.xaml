<UserControl x:Class="PhotoOk.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PhotoOk.Views">
    <UserControl.Resources>
        <views:HistoryStatusTextConverter x:Key="RunStatusText" />
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,24,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,40" MaxWidth="720" HorizontalAlignment="Left">
            <TextBlock Text="PhotoOK" FontSize="32" FontWeight="Bold" />
            <TextBlock Text="촬영한 사진을 날짜별로 안전하게 정리합니다." Margin="0,4,0,0" Opacity="0.7" />

            <Border Margin="0,24,0,0" Padding="12" BorderThickness="1" BorderBrush="#E0A800" Background="#FFF8E1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UnfinishedRun}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <TextBlock Text="끝나지 않은 작업이 있습니다" FontWeight="SemiBold" Foreground="#5F4B00" />
                    <!-- Run 사이에 줄을 바꾸면 그 자리에 빈칸이 생긴다. 띄어 쓸 곳은 Run 글자에 직접 넣는다. -->
                    <TextBlock Foreground="#5F4B00" TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run Text="{Binding UnfinishedRun.StartedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" /><Run Text=" · " /><Run Text="{Binding UnfinishedRun.ArchiveRoot, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UnfinishedRun.CompletedFiles, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding UnfinishedRun.FileOperations, Mode=OneWay}" /><Run Text="개 처리" />
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="이어 하기" Command="{Binding ResumeUnfinishedCommand}" Padding="16,4" Margin="0,0,8,0" />
                        <Button Content="되돌리기" Command="{Binding UndoUnfinishedCommand}" Padding="16,4" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                <Button Content="새로 가져오기" Command="{Binding StartImportCommand}" Padding="24,10" FontSize="15" />
                <Button Content="작업 기록" Command="{Binding OpenHistoryCommand}" Padding="24,10" FontSize="15" Margin="12,0,0,0" />
            </StackPanel>

            <TextBlock Text="연결된 이동식 드라이브" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="연결된 이동식 드라이브가 없습니다." Opacity="0.7">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Drives.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" (" /><Run Text="{Binding Root, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <Button Grid.Column="1" Content="이 드라이브에서 가져오기" Padding="12,4"
                                    Command="{Binding DataContext.ImportFromDriveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="최근 작업" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{Binding HistoryNotice}" Opacity="0.7">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HistoryNotice}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ItemsControl ItemsSource="{Binding RecentRuns}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Margin="0,0,0,4" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding StartedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" /><Run Text=" · " /><Run Text="{Binding Status, Mode=OneWay, Converter={StaticResource RunStatusText}}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ArchiveRoot, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
