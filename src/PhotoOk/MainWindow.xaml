<Window x:Class="PhotoOk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoOk.ViewModels"
        xmlns:views="clr-namespace:PhotoOk.Views"
        Title="PhotoOK"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 화면 ViewModel 타입마다 뷰를 하나씩 등록한다. -->
        <DataTemplate DataType="{x:Type vm:StartViewModel}">
            <views:StartView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SourceViewModel}">
            <views:SourceView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}">
            <views:ScanView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <views:PreviewView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RunViewModel}">
            <views:RunView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
            <views:HistoryView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding Current}" Focusable="False" />
</Window>
