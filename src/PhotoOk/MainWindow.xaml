<Window x:Class="PhotoOk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhotoOk.ViewModels"
        xmlns:views="clr-namespace:PhotoOk.Views"
        Title="PhotoOK"
        Width="1200" Height="800"
        MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 화면 ViewModel 타입마다 뷰를 하나씩 등록한다. -->
        <DataTemplate DataType="{x:Type vm:StartPlaceholderViewModel}">
            <views:StartPlaceholderView />
        </DataTemplate>
    </Window.Resources>

    <ContentControl Content="{Binding Current}" Focusable="False" />
</Window>
